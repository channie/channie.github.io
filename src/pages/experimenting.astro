---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ArrowLink from '../components/ArrowLink.astro';

const head = {
  eyebrow: 'Experimenting',
  title: 'Things I’m trying out',
  intro:
    'Small projects, experiments, and AI workflows. Thinking out loud while it’s still in progress.',
};

const all = (await getCollection('experiments', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const featured = all.find((e) => e.data.featured) ?? all[0];
const rest = all.filter((e) => e.id !== featured?.id);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(d);
// co-located posts are <slug>/index.md → keep the URL as /experimenting/<slug>
const slugOf = (id: string) => id.replace(/\/index$/, '');
const href = (id: string) => `/experimenting/${slugOf(id)}/`;
---

<BaseLayout title="Experimenting" active="Experimenting" description={head.intro}>
  <div class="col">
    <PageHead eyebrow={head.eyebrow} title={head.title} intro={head.intro} />

  {
    featured && (
      <a class:list={['artfeat', { 'no-hero': !featured.data.hero }]} href={href(featured.id)} aria-label={featured.data.title}>
        {featured.data.hero && (
          <div class="afimg">
            <Image src={featured.data.hero} alt="" widths={[480, 720, 960]} sizes="(min-width:600px) 50vw, 90vw" />
          </div>
        )}
        <div class="afbody">
          <div class="afhead">
            {!featured.data.hero && (
              <span class="afeatured"><span class="star">✦</span> Featured</span>
            )}
            <p class="ameta">
              <span class="acat">{featured.data.category}</span>
              <span class="adot">·</span><time datetime={featured.data.date.toISOString()}>{fmt(featured.data.date)}</time>
              {featured.data.read && (<><span class="adot">·</span>{featured.data.read} read</>)}
            </p>
          </div>
          <h2 class="atitle">{featured.data.title}</h2>
          <p class="aexc">{featured.data.excerpt}</p>
          <ArrowLink as="span">Read the note</ArrowLink>
        </div>
      </a>
    )
  }

  <div class="artlist">
    {
      rest.map((e, i) => (
        <a class:list={['artrow', { 'img-left': i % 2 === 1 }]} href={href(e.id)} aria-label={e.data.title}>
          <div class="arbody">
            <p class="ameta">
              <span class="acat">{e.data.category}</span>
              <span class="adot">·</span><time datetime={e.data.date.toISOString()}>{fmt(e.data.date)}</time>
              {e.data.read && (<><span class="adot">·</span>{e.data.read} read</>)}
            </p>
            <h3 class="artitle">{e.data.title}</h3>
            <p class="aexc row">{e.data.excerpt}</p>
            <ArrowLink as="span" class="rowcta">Read the note</ArrowLink>
          </div>
          <div class="arthumb">
            {e.data.hero ? (
              <Image src={e.data.hero} alt="" widths={[96, 220, 440]} sizes="220px" />
            ) : (
              <span class="tile small">{e.data.category}</span>
            )}
          </div>
        </a>
      ))
    }
    </div>
  </div>
</BaseLayout>

<style>
  .ameta {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }
  .acat {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .adot {
    opacity: 0.5;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease);
  }

  /* CSS fallback "cover" for posts without an image */
  .tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--accent) 10%, var(--card));
    color: var(--accent);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow-tight);
    font-weight: 700;
    font-size: var(--text-xs);
    text-align: center;
    padding: var(--space-2);
  }
  .tile::before {
    content: '✦';
    color: var(--accent2);
    margin-right: 6px;
  }

  /* ---- Featured article ---- */
  .artfeat {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin: 8px var(--gutter);
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }
  /* ✦ Featured marker — stands in for the photo as the "this is featured" cue */
  .afeatured {
    font-family: var(--font-sans);
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--text-xs);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .afeatured .star {
    color: var(--accent2);
  }

  /* no hero image -> a framed "cover" panel: the card surface + hairline and
     accent top-rule mark it as featured in place of the photo, and the text
     runs full content width inside the frame */
  .artfeat.no-hero {
    grid-template-columns: 1fr;
    margin: 8px var(--gutter) 6px;
    padding: 24px var(--space-6);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-card);
    background: var(--card);
  }
  .artfeat.no-hero .afbody {
    justify-content: flex-start;
  }
  .artfeat.no-hero .afhead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .artfeat.no-hero .atitle {
    font-size: var(--text-4xl);
    max-width: 24ch;
    transition: color 0.2s var(--ease);
  }
  .artfeat.no-hero .aexc {
    max-width: 64ch;
  }
  .artfeat.no-hero:hover .atitle {
    color: var(--accent);
  }
  .afimg {
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--card);
    height: 220px;
  }
  .artfeat:hover .afimg img {
    transform: scale(1.04);
  }
  .afbody {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }
  .atitle {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.1;
    font-size: var(--text-3xl);
  }
  .aexc {
    font-family: var(--font-sans);
    color: var(--muted);
    line-height: 1.62;
    font-size: var(--text-md);
  }

  /* ---- List rows ---- */
  .artlist {
    padding: 6px var(--gutter) 20px;
  }
  .artrow {
    display: grid;
    grid-template-columns: 1fr 96px;
    gap: 18px;
    align-items: center;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--line);
  }
  .arbody {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .artitle {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.16;
    letter-spacing: -0.005em;
    font-size: var(--text-xl);
    transition: color 0.2s var(--ease);
  }
  .artrow:hover .artitle {
    color: var(--accent);
  }
  /* interleave the thumbnail side down the list (even rows keep it on the
     right, odd rows flip it left) so the column doesn't march in a straight line */
  .artrow.img-left {
    grid-template-columns: 96px 1fr;
  }
  .artrow.img-left .arthumb {
    order: -1;
  }
  .aexc.row {
    display: none;
  }
  /* per-row "Read the note →" cue (a styled span — the whole row is the link,
     so it can't nest an <a>); matches the featured card. Arrow nudges on row
     hover, and it stays visible on mobile where the excerpt is hidden. */
  .arbody :global(.rowcta) {
    margin-top: 2px;
  }
  .artrow:hover :global(.rowcta .arw) {
    transform: translateX(5px);
  }
  .arthumb {
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--card);
    height: 96px;
  }
  .artrow:hover .arthumb img {
    transform: scale(1.05);
  }

  @container page (min-width: 600px) {
    .artfeat {
      grid-template-columns: 1.05fr 1fr;
      gap: var(--space-10);
      margin: 14px var(--gutter) 8px;
      padding-bottom: var(--space-12);
    }
    /* roomier frame on wider viewports */
    .artfeat.no-hero {
      margin: 16px var(--gutter) 8px;
      padding: 30px 34px;
    }
    .afimg {
      height: 320px;
    }
    .artlist {
      padding: 18px var(--gutter) 30px;
    }
    .artrow {
      grid-template-columns: 1fr 200px;
      gap: 36px;
      padding: 32px 0;
    }
    .artrow.img-left {
      grid-template-columns: 200px 1fr;
    }
    .aexc.row {
      display: block;
      margin: 0;
    }
    .arthumb {
      height: 128px;
    }
  }

  @container page (min-width: 1024px) {
    .artfeat {
      gap: var(--space-12);
      padding-bottom: 52px;
    }
    .afimg {
      height: 360px;
    }
    .artrow {
      grid-template-columns: 1fr 220px;
      gap: var(--space-10);
      padding: 34px 0;
    }
    .artrow.img-left {
      grid-template-columns: 220px 1fr;
    }
    .arthumb {
      height: 132px;
    }
  }
</style>
