---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import RoomCard from '../components/RoomCard.astro';
import PodcastBand from '../components/PodcastBand.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { explore, rooms } from '../data/home';
import { heroPreloadSrcset, HERO_SIZES, HERO_PRELOAD_TYPE } from '../lib/heroImage';

const featured = rooms.filter((r) => r.featured);
const secondary = rooms.filter((r) => !r.featured);

/* The hero photo is this page's LCP element; preload it from <head> so the
   fetch doesn't wait for the parser to reach <Hero />. */
const heroPreload = {
  srcset: await heroPreloadSrcset(),
  sizes: HERO_SIZES,
  type: HERO_PRELOAD_TYPE,
};
---

<BaseLayout header="none" preloadImage={heroPreload}>
  {/* The hero is a credo blockquote, not a heading — give the page a real,
      screen-reader-only <h1> so its outline starts at h1 (then the Explore h2). */}
  <h1 class="sr-only">Channie — personal site</h1>
  <Hero />

  <div class="home-content">
    <section class="secintro">
      <Eyebrow>{explore.eyebrow}</Eyebrow>
      <h2>{explore.headingLead}<br /><em>{explore.headingEm}</em></h2>
      <p class="intro">{explore.intro}</p>
    </section>

    <div class="rooms">
      <div class="feat-row">
        {featured.map((r) => <RoomCard room={r} />)}
      </div>
      <div class="sec-row">
        {secondary.map((r) => <RoomCard room={r} />)}
      </div>
    </div>

    <PodcastBand />
  </div>
</BaseLayout>

<style>
  .home-content {
    position: relative;
    background: var(--bg);
  }

  /* Below-hero content sits in a narrower centered column on desktop.
     (max-width only bites above ~1080px, so mobile/tablet are unchanged.) */
  .secintro,
  .rooms {
    max-width: var(--content-max);
    margin-inline: auto;
  }

  /* ---- Section intro ---- */
  .secintro {
    padding: 48px var(--gutter) 8px;
  }
  .secintro h2 {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin-top: var(--space-4);
    font-size: var(--text-4xl);
  }
  .secintro h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .intro {
    font-family: var(--font-sans);
    color: var(--muted);
    margin-top: var(--space-4);
    line-height: 1.6;
    font-size: var(--text-md);
    max-width: 440px;
  }

  /* ---- Rooms grid: 2 featured + 2 secondary ---- */
  .rooms {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 26px var(--gutter) 12px;
  }
  .feat-row,
  .sec-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @container page (min-width: 600px) {
    .secintro {
      padding: 62px var(--gutter) 10px;
    }
    .rooms {
      gap: var(--space-5);
      padding: 30px var(--gutter) 16px;
    }
    .feat-row,
    .sec-row {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
  }

  @container page (min-width: 1024px) {
    .secintro {
      padding: 78px var(--gutter) 14px;
    }
    .rooms {
      gap: 22px;
      padding: 36px var(--gutter) 20px;
    }
    .feat-row,
    .sec-row {
      gap: 22px;
    }
  }
</style>
