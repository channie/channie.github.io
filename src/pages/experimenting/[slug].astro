---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureArticle from '../../layouts/FeatureArticle.astro';
import VideoLoop from '../../components/feature/VideoLoop.astro';

export async function getStaticPaths() {
  const entries = await getCollection('experiments', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    // co-located posts are <slug>/index.md → strip the trailing /index
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
/* `presentation: feature` swaps the whole article presentation for the
   magazine frame (FeatureArticle). Everything else keeps the single-column
   post. (The field can't be called `layout` — that key is reserved by MDX.) */
const isFeature = entry.data.presentation === 'feature';
// Display cap for the hero image; posts can override via `heroWidth` frontmatter.
const heroW = entry.data.heroWidth ?? 460;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(d);
---

<BaseLayout
  title={entry.data.title}
  active="Experimenting"
  description={entry.data.excerpt}
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
  ogImage={entry.data.ogImage}
  ogImageAlt={entry.data.ogImageAlt}
>
  {isFeature ? (
    <FeatureArticle entry={entry}>
      <Content />
    </FeatureArticle>
  ) : (
  <article class="post">
    <a class="back" href="/experimenting/">← Experimenting</a>

    <p class="ameta">
      <span class="acat">{entry.data.category}</span>
      <span class="adot">·</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
      {entry.data.read && (<><span class="adot">·</span>{entry.data.read} read</>)}
    </p>
    <h1>{entry.data.title}</h1>

    {
      entry.data.heroVideo && entry.data.hero ? (
        <div
          class="post-hero"
          style={`--hero-w: ${heroW}px; --hero-aspect: ${entry.data.hero.width} / ${entry.data.hero.height}`}
        >
          {/* motion hero: <VideoLoop> is a pausable, muted loop that does NOT
              autoplay under prefers-reduced-motion and pauses off screen; the
              poster (hero) reserves the space so there's no layout shift. */}
          <VideoLoop
            src={entry.data.heroVideo}
            poster={entry.data.hero}
            label={entry.data.heroAlt ?? entry.data.title}
          />
        </div>
      ) : entry.data.hero ? (
        <div class="post-hero" style={`--hero-w: ${heroW}px`}>
          {/* widths/sizes track the display cap so we never ship oversized pixels.
              alt: heroAlt when the image is informational, else decorative. */}
          <Image src={entry.data.hero} alt={entry.data.heroAlt ?? ''} widths={[heroW, heroW * 2]} sizes={`min(92vw, ${heroW}px)`} />
        </div>
      ) : null
    }

    <div class="prose">
      <Content />
    </div>
  </article>
  )}
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px var(--gutter) 64px;
  }
  .back {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--accent);
    font-weight: 600;
  }
  .ameta {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .acat {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .adot {
    opacity: 0.5;
  }
  h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin-top: 14px;
    font-size: var(--text-4xl);
  }
  .post-hero {
    margin-top: 28px;
    /* default cap; a post can override via the `heroWidth` frontmatter field */
    max-width: var(--hero-w, 460px);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--card);
  }
  .post-hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  /* reserve the motion hero's space from the poster's ratio so it doesn't
     shift as the clip loads (the <VideoLoop> video is width:100%/height:auto) */
  .post-hero :global(video) {
    aspect-ratio: var(--hero-aspect);
  }
  .prose {
    margin-top: 28px;
  }
  .prose :global(p) {
    font-family: var(--font-sans);
    color: var(--ink);
    /* long-form body runs a step larger than the 14px UI base for comfortable
       sustained reading (lists below match); chrome/meta keep their own sizes */
    font-size: var(--text-prose);
    line-height: 1.7;
    /* standard document paragraph spacing */
    margin-bottom: 1em;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 1.9em;
    margin-bottom: 0.7em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.005em;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    font-family: var(--font-sans);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: 1.7;
    margin-bottom: 1em;
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(li)::marker {
    color: var(--accent);
  }
  .prose :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  /* Shiki inlines the (recolored) dark "Ink" background on <pre>; we own
     only the box geometry around it. */
  .prose :global(pre) {
    border-radius: var(--radius-media);
    padding: 14px 16px;
    margin-bottom: 1em;
    overflow-x: auto;
    line-height: 1.6;
  }
  /* inside a block the inline-code chrome resets (the <pre> carries it) */
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--text-md);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(hr) {
    border: none;
    height: 1px;
    width: 64px;
    background: var(--line);
    margin: 2.2em auto;
  }
  /* inline images in a post (full content-width, optimized by Astro) */
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    background: var(--card);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--ink);
  }

  /* ── "Getting Out of the Loop" post: highlights, tables, kept/dropped
        cards, eval staircase, asterism, footnote. Styled with tokens so it
        tracks the site's themes; scoped to injected .prose via :global. ── */
  .prose :global(mark) {
    color: inherit;
    font-weight: 700;
    background: linear-gradient(
        color-mix(in srgb, var(--accent2) 34%, transparent),
        color-mix(in srgb, var(--accent2) 34%, transparent)
      ) no-repeat 0 88% / 100% 42%;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding: 0 0.04em;
  }

  /* tables */
  .prose :global(.tbl) { overflow-x: auto; margin: 1.15em 0; }
  .prose :global(table) {
    border-collapse: collapse;
    width: 100%;
    font-family: var(--font-sans);
    font-size: 0.94em;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--line);
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .prose :global(thead th) { background: var(--card); font-weight: 700; }
  .prose :global(table.cmp) { table-layout: fixed; }
  .prose :global(table.cmp th:nth-child(1)),
  .prose :global(table.cmp td:nth-child(1)) { width: 30%; }
  .prose :global(table.cmp th:nth-child(2)),
  .prose :global(table.cmp td:nth-child(2)) { width: 16%; }
  .prose :global(table.cmp th:nth-child(3)),
  .prose :global(table.cmp td:nth-child(3)) { width: 54%; }
  .prose :global(.becomes) {
    text-align: center;
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1em;
    margin: 0.2em 0 0.1em;
  }

  /* kept / dropped cards */
  .prose :global(.kd) { display: flex; flex-wrap: wrap; gap: 12px; margin: 0.4em 0 1em; }
  .prose :global(.kd .card) {
    flex: 1 1 240px;
    border: 1px solid var(--line);
    border-radius: var(--radius-media);
    padding: 14px 16px;
    background: var(--card);
  }
  .prose :global(.kd .tag) {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow-tight);
    text-transform: uppercase;
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    margin-bottom: 9px;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    color: var(--muted);
  }
  /* KEPT = grounded/positive → moss (--kept); DROPPED = flagged → rajah */
  .prose :global(.kd .kept) { border-color: color-mix(in srgb, var(--kept) 48%, var(--line)); }
  .prose :global(.kd .kept .tag) {
    background: color-mix(in srgb, var(--kept) 20%, transparent);
    color: color-mix(in srgb, var(--kept) 72%, var(--ink));
  }
  .prose :global(.kd .dropped) { border-color: color-mix(in srgb, var(--accent2) 55%, var(--line)); }
  .prose :global(.kd .dropped .tag) {
    background: color-mix(in srgb, var(--accent2) 22%, transparent);
    color: color-mix(in srgb, var(--accent) 88%, var(--ink));
  }
  .prose :global(.kd .claim) { font-size: 0.95em; line-height: 1.5; }
  .prose :global(.kd .gloss) { display: block; color: var(--muted); font-style: italic; margin-top: 6px; }
  .prose :global(.kd .why) { font-size: 0.82em; color: var(--muted); margin-top: 9px; }

  /* eval staircase */
  .prose :global(.stairA) { display: flex; flex-direction: column; gap: 10px; margin: 1.4em 0; }
  .prose :global(.stairA .step) {
    border: 1px solid var(--line);
    border-left-width: 4px;
    border-radius: var(--radius-media);
    padding: 11px 14px;
    background: var(--card);
  }
  .prose :global(.stairA .s1) { margin-left: 0; border-left-color: color-mix(in srgb, var(--ink) 34%, var(--line)); }
  .prose :global(.stairA .s2) { margin-left: 40px; border-left-color: var(--accent2); }
  .prose :global(.stairA .s3) { margin-left: 80px; border-left-color: var(--accent); }
  .prose :global(.stairA .row) { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .prose :global(.stairA .cost) {
    font-family: var(--font-sans);
    font-size: var(--text-2xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow-tight);
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .prose :global(.stairA .c-free) { background: color-mix(in srgb, var(--ink) 10%, transparent); color: var(--muted); }
  .prose :global(.stairA .c-cheap) { background: color-mix(in srgb, var(--accent2) 22%, transparent); color: color-mix(in srgb, var(--accent) 88%, var(--ink)); }
  /* text darkened toward ink (like .c-cheap) so the $$ pill clears WCAG AA on
     its own tint; pure --accent here measured 4.42:1 */
  .prose :global(.stairA .c-dear) { background: color-mix(in srgb, var(--accent) 15%, transparent); color: color-mix(in srgb, var(--accent) 88%, var(--ink)); }
  .prose :global(.stairA .name) { font-weight: 700; }
  .prose :global(.stairA .desc) { font-size: 0.86em; color: var(--muted); margin-top: 3px; }
  @media (max-width: 560px) {
    .prose :global(.stairA .s2) { margin-left: 20px; }
    .prose :global(.stairA .s3) { margin-left: 40px; }
  }

  /* asterism section break */
  .prose :global(.brk-dots) { display: flex; justify-content: center; gap: 14px; margin: 2.6em 0; }
  .prose :global(.brk-dots span) { width: 5px; height: 5px; border-radius: 50%; background: var(--accent2); display: block; }

  /* footnote */
  .prose :global(.fnref) { color: var(--accent); font-weight: 700; font-size: 0.85em; }
  .prose :global(.fn) {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted);
    margin-top: 1.6em;
    padding-top: 0.9em;
    border-top: 1px solid var(--line);
  }
  .prose :global(.fn .fnmark) { color: var(--accent); font-weight: 700; margin-right: 0.3em; }
  /* footnote marker links (ref <-> note): keep the bare-marker look, not the
     underlined body-link style; underline only on hover/focus */
  .prose :global(.fnref a),
  .prose :global(a.fnmark) {
    color: var(--accent);
    text-decoration: none;
  }
  .prose :global(.fnref a:hover),
  .prose :global(a.fnmark:hover),
  .prose :global(.fnref a:focus-visible),
  .prose :global(a.fnmark:focus-visible) {
    text-decoration: underline;
  }
</style>
