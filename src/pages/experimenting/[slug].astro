---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureArticle from '../../layouts/FeatureArticle.astro';

export async function getStaticPaths() {
  const entries = await getCollection('experiments', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    // co-located posts are <slug>/index.md → strip the trailing /index
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
/* `presentation: feature` swaps the whole article presentation for the
   magazine frame (FeatureArticle). Everything else keeps the single-column
   post. (The field can't be called `layout` — that key is reserved by MDX.) */
const isFeature = entry.data.presentation === 'feature';
// Display cap for the hero image; posts can override via `heroWidth` frontmatter.
const heroW = entry.data.heroWidth ?? 460;
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(d);
---

<BaseLayout
  title={entry.data.title}
  active="Experimenting"
  description={entry.data.excerpt}
  ogType="article"
  publishedTime={entry.data.date.toISOString()}
>
  {isFeature ? (
    <FeatureArticle entry={entry}>
      <Content />
    </FeatureArticle>
  ) : (
  <article class="post">
    <a class="back" href="/experimenting/">← Experimenting</a>

    <p class="ameta">
      <span class="acat">{entry.data.category}</span>
      <span class="adot">·</span><time datetime={entry.data.date.toISOString()}>{fmt(entry.data.date)}</time>
      {entry.data.read && (<><span class="adot">·</span>{entry.data.read} read</>)}
    </p>
    <h1>{entry.data.title}</h1>

    {
      entry.data.hero && (
        <div class="post-hero" style={`--hero-w: ${heroW}px`}>
          {/* widths/sizes track the display cap so we never ship oversized pixels.
              alt: heroAlt when the image is informational, else decorative. */}
          <Image src={entry.data.hero} alt={entry.data.heroAlt ?? ''} widths={[heroW, heroW * 2]} sizes={`min(92vw, ${heroW}px)`} />
        </div>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>
  )}
</BaseLayout>

<style>
  .post {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px var(--gutter) 64px;
  }
  .back {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--accent);
    font-weight: 600;
  }
  .ameta {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: var(--text-sm);
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .acat {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  .adot {
    opacity: 0.5;
  }
  h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.015em;
    line-height: 1.05;
    margin-top: 14px;
    font-size: var(--text-4xl);
  }
  .post-hero {
    margin-top: 28px;
    /* default cap; a post can override via the `heroWidth` frontmatter field */
    max-width: var(--hero-w, 460px);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--card);
  }
  .post-hero :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .prose {
    margin-top: 28px;
  }
  .prose :global(p) {
    font-family: var(--font-sans);
    color: var(--ink);
    /* long-form body runs a step larger than the 14px UI base for comfortable
       sustained reading (lists below match); chrome/meta keep their own sizes */
    font-size: var(--text-prose);
    line-height: 1.7;
    /* standard document paragraph spacing */
    margin-bottom: 1em;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-top: 1.9em;
    margin-bottom: 0.7em;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 500;
    color: var(--ink);
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: -0.005em;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    font-family: var(--font-sans);
    color: var(--ink);
    font-size: var(--text-prose);
    line-height: 1.7;
    margin-bottom: 1em;
    padding-left: 1.4em;
  }
  .prose :global(li) {
    margin-bottom: 0.35em;
  }
  .prose :global(li)::marker {
    color: var(--accent);
  }
  .prose :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.92em;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  /* Shiki inlines the (recolored) dark "Ink" background on <pre>; we own
     only the box geometry around it. */
  .prose :global(pre) {
    border-radius: var(--radius-media);
    padding: 14px 16px;
    margin-bottom: 1em;
    overflow-x: auto;
    line-height: 1.6;
  }
  /* inside a block the inline-code chrome resets (the <pre> carries it) */
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--text-md);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(hr) {
    border: none;
    height: 1px;
    width: 64px;
    background: var(--line);
    margin: 2.2em auto;
  }
  /* inline images in a post (full content-width, optimized by Astro) */
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    background: var(--card);
  }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 20px;
    border-left: 2px solid var(--accent2);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--ink);
  }
</style>
