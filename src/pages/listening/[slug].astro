---
/* ============================================================
   Listening · show detail — one page per show (/listening/<id>).

   Two data-driven templates:
   - T1 "Quiet links" (default) — centered cover + identity, then
     optional Notes and Episode highlights. The "listen on" links are
     QUIET: a small lead label + underlined inline platform links, not a
     solid CTA. Used whenever the show has episodes, or has neither notes
     nor episodes.
   - B2 "The note is the page" — used ONLY when the show has a note and
     NO episodes: a compact header (cover + identity), the note set large
     as the body, and a single quiet "listen on" footer line.

   A show can carry one OR several listen links (`url` is normalized to an
   array); each platform's name + icon are derived from its hostname.

   Section labels are bilingual and follow `lang`: a Chinese show leads
   with the Chinese label (札記 / 推薦單集) trailing the English; an
   English show shows the English label only. The episode label depends on
   kind — Podcast: Episodes to start with · YouTube: Worth a watch.
   ============================================================ */
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { platform } from '../../data/platform';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const shows = await getCollection('listening', ({ data }) => !data.draft);
  return shows.map((entry) => ({
    params: { slug: entry.id.replace(/\/index$/, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'listening'>;
}
const { entry } = Astro.props as Props;
const d = entry.data;
const lang = d.lang;
const zh = lang === 'zh';

const { Content } = await render(entry);

const initial = d.title.trim().charAt(0);
const hasLogo = Boolean(d.logo);
const episodes = d.episodes ?? [];
const hasEps = episodes.length > 0;
const hasNotes = Boolean(entry.body && entry.body.trim());

// One or several listen links — each carries its derived platform.
const platforms = d.url.map((u) => ({ ...platform(u, lang), url: u }));

// B2 "the note is the page" only when there's a note and no episodes.
const isNotePage = hasNotes && !hasEps;

// Section labels. The zh tab shows the Chinese label + a short English
// trailing label (e.g. EPISODE HIGHLIGHTS); the en tab shows the English
// label only, in its fuller wording (e.g. "Episodes to start with").
const notesLabel = { zh: '札記', trailing: 'Notes', en: 'Notes' };
const epsLabel =
  d.kind === 'YouTube'
    ? { zh: '推薦影片', trailing: 'Worth a watch', en: 'Worth a watch' }
    : { zh: '推薦單集', trailing: 'Episode highlights', en: 'Episodes to start with' };

// Back link always reads "Listening" (English) — the diary page is one
// flowing list, so there's no tab hash to restore.
const back = 'Listening';
const backHref = '/listening/';
const signOff = `— ${site.name}`;
// BCP-47 lang for the show's own text (title / by / notes / episodes) when
// it's a Chinese show — so screen readers and CJK line-breaking treat it as
// Traditional Chinese, not English. `undefined` on en shows adds no attr.
const zhLang = zh ? 'zh-Hant' : undefined;
const metaDescription = `${d.kind === 'YouTube' ? 'A YouTube channel' : 'A podcast'}${d.by ? ` by ${d.by}` : ''} on Channie's listening shelf.`;
---

<BaseLayout title={d.title} active="Listening" description={metaDescription}>
  <div class:list={['show', { 'is-note': isNotePage }]}>
    <div class="wrap">
      <a class="back" href={backHref}>
        <Icon name="arrow" size={15} class="back-ico" />{back}
      </a>

      {
        isNotePage ? (
          /* ---- B2 · the note is the page ---- */
          <Fragment>
            <header class="note-head">
              <span class="cover" style={!hasLogo && d.color ? `background:${d.color}` : undefined}>
                {hasLogo && <Image src={d.logo!} alt="" widths={[120, 240]} sizes="110px" class="cover-img" />}
                {!hasLogo && <span class="cover-initial" aria-hidden="true">{initial}</span>}
              </span>
              <div class="note-id">
                <p class="kind">{d.kind}</p>
                <h1 class="title" lang={zhLang}>{d.title}</h1>
                {d.by && <p class="by" lang={zhLang}>{d.by}</p>}
              </div>
            </header>

            <div class="letter">
              <span class="quote-mark" aria-hidden="true">&ldquo;</span>
              <div class="notes" lang={zhLang}>
                <Content />
              </div>
              {d.signed && <p class="sig">{signOff}</p>}
            </div>

            <footer class="foot-listen">
              <span lang={zhLang}>{zh ? '可以在' : 'Also on'}</span>
              {platforms.map((p, i) => (
                <Fragment>
                  {i > 0 && <span class="dot">·</span>}
                  <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
                </Fragment>
              ))}
              {zh && <span lang="zh-Hant">收聽</span>}
            </footer>
          </Fragment>
        ) : (
          /* ---- T1 · quiet links (default) ---- */
          <Fragment>
            <header class="hero">
              <span class="cover" style={!hasLogo && d.color ? `background:${d.color}` : undefined}>
                {hasLogo && <Image src={d.logo!} alt="" widths={[180, 360]} sizes="160px" class="cover-img" />}
                {!hasLogo && <span class="cover-initial" aria-hidden="true">{initial}</span>}
              </span>
              <p class="kind">{d.kind}</p>
              <h1 class="title" lang={zhLang}>{d.title}</h1>
              {d.by && <p class="by" lang={zhLang}>{d.by}</p>}

              <div class="listen">
                <span class="listen-lead" lang={zhLang}>{zh ? '收聽' : 'Listen'}</span>
                {platforms.map((p) => (
                  <a class="qlink" href={p.url} target="_blank" rel="noopener noreferrer">
                    <Icon name={`platform-${p.slug}`} size={15} />
                    <span>{p.name}</span>
                    <Icon name="arrow-up-right" size={12} class="qlink-arw" />
                  </a>
                ))}
              </div>
            </header>

            {hasNotes && (
              <section class="block">
                <div class="sec-label">
                  {zh && <span class="sec-zh" lang="zh-Hant">{notesLabel.zh}</span>}
                  <span class="sec-en">{zh ? notesLabel.trailing : notesLabel.en}</span>
                </div>
                <div class="notes" lang={zhLang}>
                  <Content />
                </div>
                {d.signed && <p class="sig">{signOff}</p>}
              </section>
            )}

            {hasEps && (
              <section class="block">
                <div class="sec-label">
                  {zh && <span class="sec-zh" lang="zh-Hant">{epsLabel.zh}</span>}
                  <span class="sec-en">{zh ? epsLabel.trailing : epsLabel.en}</span>
                </div>
                <div class="eps">
                  {episodes.map((ep, i) => {
                    const epPlat = platform(ep.url, lang);
                    return (
                      <a class="ep" href={ep.url} target="_blank" rel="noopener noreferrer">
                        <span class="ep-no">{String(i + 1).padStart(2, '0')}</span>
                        <span class="ep-title" lang={zhLang}>{ep.title}</span>
                        <span class="ep-plat">
                          <Icon name={`platform-${epPlat.slug}`} size={14} />
                          {epPlat.name}
                        </span>
                      </a>
                    );
                  })}
                </div>
              </section>
            )}
          </Fragment>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .show {
    background: var(--bg);
    padding: 26px var(--gutter) 40px;
  }
  .wrap {
    max-width: 620px;
    margin: 0 auto;
  }
  .show.is-note .wrap {
    max-width: 640px;
  }

  /* ---- back ---- */
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    white-space: nowrap;
  }
  .back :global(.back-ico) {
    transform: scaleX(-1);
    transition: transform 0.25s var(--ease);
  }
  .back:hover :global(.back-ico) {
    transform: scaleX(-1) translateX(-4px);
  }

  /* ---- cover (shared by both templates) ---- */
  .cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    color: #f7e9d6;
    box-shadow: 0 18px 38px -22px rgba(0, 0, 0, 0.6);
  }
  .cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-initial {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-6xl);
    line-height: 1;
    opacity: 0.96;
  }

  /* ---- identity (shared) ---- */
  .kind {
    font-family: var(--font-sans-latin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--accent);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-3xl);
    line-height: 1.18;
    color: var(--ink);
    margin-top: 14px;
    text-wrap: balance;
  }
  .by {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--muted);
    margin-top: 9px;
  }

  /* ---- T1 hero (centered) ---- */
  .hero {
    text-align: center;
    padding: 22px 0 6px;
  }
  .hero .cover {
    width: 138px;
    margin: 0 auto 22px;
  }

  /* ---- quiet listen links (T1) ---- */
  .listen {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 18px;
    margin-top: 22px;
  }
  .listen-lead {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow-tight);
    font-size: var(--text-2xs);
    font-weight: 700;
    color: var(--muted);
  }
  .qlink {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    white-space: nowrap;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .qlink:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .qlink :global(.qlink-arw) {
    opacity: 0.55;
    transition: transform 0.2s var(--ease);
  }
  .qlink:hover :global(.qlink-arw) {
    transform: translate(2px, -2px);
  }

  /* ---- section label ---- */
  .block {
    margin-top: 46px;
    text-align: left;
  }
  .sec-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .sec-zh {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    white-space: nowrap;
  }
  .sec-en {
    font-family: var(--font-sans-latin);
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .sec-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  /* ---- notes (quiet journal) ---- */
  .notes {
    margin-top: 22px;
  }
  /* notes come from the show's Markdown body (rendered, so :global).
     remark-breaks turns the authored line breaks into <br>. */
  .notes :global(p) {
    font-family: var(--font-display);
    /* Latin → Newsreader italic; CJK → WenKai upright (via the italic
       WenKai face mapped to the upright file in fonts-cjk.css). */
    font-style: italic;
    color: var(--ink);
    font-size: var(--text-lg);
    line-height: 1.75;
    margin: 0;
  }
  .notes :global(p + p) {
    margin-top: 1.1em;
  }
  .notes :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sig {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  /* ---- recommended episodes ---- */
  .eps {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
  }
  .ep {
    display: grid;
    grid-template-columns: 34px 1fr auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .ep:first-child {
    border-top: none;
  }
  .ep-no {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--accent2);
    line-height: 1;
  }
  .ep-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-lg);
    line-height: 1.34;
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }
  .ep:hover .ep-title {
    color: var(--accent);
  }
  .ep-plat {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    padding-top: var(--space-1);
    transition: color 0.2s var(--ease);
  }
  .ep:hover .ep-plat {
    color: var(--accent);
  }

  /* ============================================================
     B2 · the note is the page
     ============================================================ */
  .note-head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-top: 8px;
    padding: 22px 0 24px;
    border-bottom: 1px solid var(--line);
  }
  .note-head .cover {
    width: 96px;
    flex: none;
  }
  .note-id {
    min-width: 0;
  }
  .note-id .title {
    margin-top: 6px;
    font-size: var(--text-2xl);
  }
  .note-id .by {
    margin-top: 6px;
  }

  .letter {
    margin-top: 34px;
  }
  .quote-mark {
    display: block;
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 0.5;
    height: 30px;
    color: var(--accent2);
    opacity: 0.9;
  }
  .letter .notes {
    margin-top: 6px;
  }
  /* note body matches the default (T1) notes size — see `.notes :global(p)` */
  .show.is-note .sig {
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }

  .foot-listen {
    margin-top: 46px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-md);
    color: var(--muted);
  }
  .foot-listen a {
    color: var(--muted);
    border-bottom: 1px solid var(--line);
    padding-bottom: 1px;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }
  .foot-listen a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .foot-listen .dot {
    color: var(--line);
  }

  @container page (min-width: 600px) {
    .show {
      padding: 32px var(--gutter) 48px;
    }
    .hero .cover {
      width: 156px;
      margin-bottom: var(--space-6);
    }
    .note-head .cover {
      width: 104px;
    }
  }
</style>
