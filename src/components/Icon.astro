---
/* ============================================================
   Icon — central inline-SVG set (monochrome, currentColor).
   Decorative by default (aria-hidden); pass a `title` to make
   it labelled/meaningful.

   `platform-*` names delegate to the shared platform artwork in
   data/platformGlyphs.ts (one drawing per brand across the site),
   rendered into a sized wrapper.
   ============================================================ */
import { platformGlyph } from '../data/platformGlyphs';

interface Props {
  name:
    | 'arrow'
    | 'arrow-up-right' // ↗ external-link nudge for quiet listen links
    | 'mail'
    | 'linkedin-badge' // "in" reversed out of a solid rounded square
    | 'play'
    | 'menu'
    | 'close'
    | 'platform-spotify'
    | 'platform-apple'
    | 'platform-youtube'
    | 'platform-soundon'
    | 'platform-link';
  size?: number;
  title?: string;
  class?: string;
}
const { name, size = 18, title, class: className } = Astro.props;
const labelled = Boolean(title);
const platformSlug = name.startsWith('platform-') ? name.slice('platform-'.length) : null;

// The lowercase "in" lettermark, drawn ~full-box in a 24×24 viewBox.
const inGlyph =
  'M6.94 5.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.4 8.4h3.5V21H3.4V8.4Zm5.7 0h3.36v1.72h.05c.47-.84 1.6-1.72 3.3-1.72 3.53 0 4.18 2.2 4.18 5.07V21h-3.5v-5.76c0-1.37-.02-3.14-1.96-3.14-1.96 0-2.26 1.5-2.26 3.04V21H9.1V8.4Z';
const common: astroHTML.JSX.SVGAttributes = {
  width: size,
  height: size,
  class: className,
  'aria-hidden': labelled ? undefined : true,
  role: labelled ? 'img' : undefined,
  'aria-label': labelled ? title : undefined,
};
---

{
  name === 'arrow' && (
    <svg {...common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )
}
{
  name === 'arrow-up-right' && (
    <svg {...common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17 17 7M9 7h8v8" />
    </svg>
  )
}
{
  name === 'mail' && (
    <svg {...common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="M4 7l8 6 8-6" />
    </svg>
  )
}
{
  name === 'linkedin-badge' && (
    <svg {...common} viewBox="0 0 24 24">
      <rect width="24" height="24" rx="4.5" fill="currentColor" />
      <path transform="translate(3.7 3.7) scale(0.69)" fill="var(--bg)" d={inGlyph} />
    </svg>
  )
}
{
  name === 'play' && (
    <svg {...common} viewBox="0 0 24 24" fill="currentColor">
      <path d="M7 4.5 19 12 7 19.5Z" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg {...common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  name === 'close' && (
    <svg {...common} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  )
}
{
  /* platform-* names share one drawing per brand from platformGlyphs.ts */
  platformSlug && (
    <span
      class:list={['icon-pf', className]}
      style={`width:${size}px;height:${size}px`}
      role={labelled ? 'img' : undefined}
      aria-label={labelled ? title : undefined}
      aria-hidden={labelled ? undefined : true}
      set:html={platformGlyph(platformSlug)}
    />
  )
}

<style>
  .icon-pf {
    display: inline-flex;
    flex: none;
  }
  .icon-pf :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
