---
/* ============================================================
   BookCover — a book's cover on a Reading spread, in one of two modes:

   - PHOTO: a co-located cover photo (frontmatter `cover`) fills the 3:4
     block (object-fit: cover), optimized by astro:assets to the display
     size (~260px, with a 2× retina variant). `color` sits behind it as a
     backdrop.
   - GENERATED (no photo): a coloured 3:4 block with an inner frame, the
     title (italic display) and author.

   The title/author here are cover ART — the heading that names the book on
   a spread lives in the caption beside this component (ReadingFlip). `big`
   is the focal cover; `priority` marks the active spread's cover so it
   loads eagerly (others lazy).
   ============================================================ */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  author: string;
  color: string;
  /** co-located cover photo; when set → photo mode, else generated block */
  cover?: ImageMetadata;
  /** alt text for the cover photo (describe it) */
  coverAlt?: string;
  big?: boolean;
  /** load eagerly + high priority (use for the active spread's cover) */
  priority?: boolean;
}
const { title, author, color, cover, coverAlt, big = false, priority = false }: Props =
  Astro.props;
---

{
  cover ? (
    <div class:list={['bcover', 'is-photo', { big }]} style={`background:${color}`}>
      <div class="bk-photo">
        <Picture
          src={cover}
          alt={coverAlt ?? ''}
          width={260}
          densities={[1, 2]}
          formats={['avif', 'webp']}
          loading={priority ? 'eager' : 'lazy'}
          decoding={priority ? 'auto' : 'async'}
          fetchpriority={priority ? 'high' : 'auto'}
        />
      </div>
    </div>
  ) : (
    <div class:list={['bcover', { big }]} style={`background:${color}`}>
      <span class="bk-rule" />
      <span class="bk-mark" aria-hidden="true">✦</span>
      <span class="bk-title">{title}</span>
      <span class="bk-author">{author}</span>
      <span class="bk-rule" />
    </div>
  )
}

<style>
  .bcover {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-book);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 22px 18px;
    text-align: center;
    color: #f7e9d6;
    box-shadow: 0 14px 34px -18px rgba(0, 0, 0, 0.5);
    overflow: hidden;
  }
  /* generated cover: inner frame (skipped in photo mode) */
  .bcover:not(.is-photo)::before {
    content: '';
    position: absolute;
    inset: 9px;
    border: 1px solid rgba(247, 233, 214, 0.34);
    border-radius: 3px;
  }
  .bk-mark {
    font-size: var(--text-md);
    color: rgba(247, 233, 214, 0.72);
  }
  .bk-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    line-height: 1.12;
    font-size: var(--text-xl);
  }
  .bcover.big .bk-title {
    font-size: var(--text-3xl);
  }
  .bk-author {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-size: var(--text-2xs);
    opacity: 0.82;
  }
  .bcover.big .bk-author {
    font-size: var(--text-xs);
  }
  .bk-rule {
    width: 30px;
    height: 1px;
    background: rgba(247, 233, 214, 0.5);
  }

  /* photo cover: fill the 3:4 block */
  .bk-photo {
    position: absolute;
    inset: 0;
  }
  .bk-photo :global(img),
  .bk-photo :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
