---
/* ============================================================
   FeatureFigure — an optimized photograph plus an editorial caption,
   at any of the feature layout's three widths.

     import cement from './cement.jpg';
     <FeatureFigure src={cement} width="full"
       lead="Mt Bachelor, Oregon."
       caption="Sierra cement adheres to the trees." />

   `lead` is the bolded place-and-date opener a magazine caption
   starts with; `caption` is the sentence after it. Both are optional.
   ============================================================ */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** bolded caption opener, e.g. "Niseko, Japan." */
  lead?: string;
  caption?: string;
  width?: 'measure' | 'wide' | 'full';
  /** optional px cap INSIDE the chosen track, centred — for a photo that
      wants most of a track but not all of it */
  maxWidth?: number;
}
const { src, alt = '', lead, caption, width = 'measure', maxWidth }: Props = Astro.props;

/* Ship pixels that match the track the figure lands in. */
const sizesFor = {
  measure: 'min(100vw, 600px)',
  wide: 'min(100vw, 920px)',
  full: '100vw',
} as const;
const widthsFor = {
  measure: [480, 768, 1200],
  wide: [768, 1200, 1840],
  full: [768, 1280, 1920, 2400],
} as const;
---

<figure
  class:list={['ffig', width === 'measure' ? '' : `u-${width}`, `is-${width}`]}
  style={maxWidth ? `--fig-max: ${maxWidth}px` : undefined}
>
  <Image src={src} alt={alt} widths={[...widthsFor[width]]} sizes={sizesFor[width]} />
  {
    (lead || caption) && (
      <figcaption>
        {lead && <b>{lead}</b>}
        {lead && caption ? ' ' : ''}
        {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .ffig {
    margin: var(--space-16) 0;
    /* --fig-max is set inline by the `maxWidth` prop; unset it fills the track */
    max-width: var(--fig-max, none);
    margin-inline: auto;
  }
  .ffig :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--card);
    border-radius: var(--radius-media);
  }
  /* A full-bleed plate runs to the page edges, so it drops the radius —
     a rounded corner against the viewport edge reads as a mistake. */
  .ffig.is-full :global(img) {
    border-radius: 0;
  }

  figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--muted);
    margin-top: var(--space-3);
  }
  figcaption b {
    color: var(--ink);
    font-weight: 600;
  }
  /* Full-bleed captions pull back to the reading measure so they stay
     findable next to the text they belong to. */
  .ffig.is-full figcaption {
    max-width: var(--feature-measure);
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--gutter);
  }
</style>
