---
/* ============================================================
   FeatureMasthead — the opening spread of a `presentation: feature` post.

   A full-bleed photograph with the editorial furniture stacked over
   its foot: kicker, headline, deck, byline. Rendered by
   FeatureArticle from the post's frontmatter — not used directly in
   MDX.

   The scrim is a hard requirement, not decoration: the type sits on
   an arbitrary photograph, so the gradient is what guarantees the
   contrast ratio. Don't remove it.
   ============================================================ */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  kicker?: string;
  deck?: string;
  byline?: string;
  hero?: ImageMetadata;
  heroAlt?: string;
}
const { title, kicker, deck, byline, hero, heroAlt = '' }: Props = Astro.props;
---

<header class:list={['masthead', { 'no-photo': !hero }]}>
  {
    hero && (
      <div class="plate">
        <Image
          src={hero}
          alt={heroAlt}
          widths={[768, 1280, 1920, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="scrim" />
      </div>
    )
  }
  <div class="lines">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1>{title}</h1>
    {deck && <p class="deck">{deck}</p>}
    {byline && <p class="byline">{byline}</p>}
  </div>
</header>

<style>
  .masthead {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(86vh, 760px);
    background: var(--hero-base);
    overflow: hidden;
  }
  /* No hero image: fall back to a type-only masthead on the page
     background, so a feature post without a photo still works. */
  .masthead.no-photo {
    min-height: 0;
    background: none;
    padding-top: var(--space-12);
  }

  .plate {
    position: absolute;
    inset: 0;
  }
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 16, 13, 0.55) 0%,
      rgba(20, 16, 13, 0.12) 38%,
      rgba(20, 16, 13, 0.86) 100%
    );
  }

  .lines {
    position: relative;
    width: 100%;
    max-width: var(--feature-max);
    margin: 0 auto;
    padding: 0 var(--gutter) var(--space-12);
    color: var(--band-ink);
  }
  .masthead.no-photo .lines {
    color: var(--ink);
    padding-bottom: 0;
  }

  .kicker {
    font-family: var(--font-sans-latin);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent2);
    margin: 0;
  }
  .masthead.no-photo .kicker {
    color: var(--accent);
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: var(--text-7xl);
    line-height: 0.98;
    letter-spacing: -0.025em;
    margin: var(--space-3) 0 0;
    max-width: 13ch;
  }

  .deck {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.5;
    max-width: 46ch;
    margin: var(--space-5) 0 0;
    color: var(--band-muted);
  }
  .masthead.no-photo .deck {
    color: var(--muted);
  }

  .byline {
    font-family: var(--font-sans-latin);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    margin: var(--space-6) 0 0;
    opacity: 0.78;
  }
</style>
