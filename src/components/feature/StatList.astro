---
/* ============================================================
   StatList — the small boxed data sidebar.

     <StatList title="The season" items={[
       { term: 'Days on snow', value: '~28' },
     ]} />

   A magazine device for facts that would read as boasting in prose:
   a data block has no ego. Renders a <dl>, so it is a real
   description list to a screen reader.
   ============================================================ */
interface Props {
  title?: string;
  items: { term: string; value: string }[];
}
const { title, items }: Props = Astro.props;
---

<aside class="stats">
  {title && <h3>{title}</h3>}
  <dl>
    {
      items.map((it) => (
        <>
          <dt>{it.term}</dt>
          <dd>{it.value}</dd>
        </>
      ))
    }
  </dl>
</aside>

<style>
  .stats {
    background: var(--card);
    border-top: 3px solid var(--accent);
    padding: var(--space-6) var(--space-8);
    margin: var(--space-12) 0;
  }
  /* h3, not h4: the sections around it are h2, so this keeps the document
     outline gap-free for screen readers. Sized by token, not by level. */
  h3 {
    font-family: var(--font-sans-latin);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 var(--space-4);
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }
  dt {
    font-family: var(--font-sans-latin);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-eyebrow-tight);
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 3px;
  }
  dd {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0;
  }
</style>
