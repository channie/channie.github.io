---
/* ============================================================
   PodcastPlayer — the "Ink" player (the one Podcast island).
   Vertical now-playing card + episode list:
     • Mobile   — full-width stack (card, then list).
     • Tablet   — centered single column.
     • Desktop  — two columns (now-playing left, episode list right).
   Streams the LATEST episode's CDN audio via a real <audio> element
   (play/pause, click/drag/keyboard scrubber, skip ±, speed, mute).
   Older episodes link out.

   Progressive enhancement: with no JS the Play control is a plain link
   to the latest episode's page, and the JS-only transport (scrubber,
   skip, speed, mute) stays hidden — the player degrades to a link.
   ============================================================ */
import { Image } from 'astro:assets';
import PlayerIcon from './PlayerIcon.astro';
import type { Episode } from '../lib/podcast';
import { podcastImage } from '../lib/podcastImages';
import { SKIP_BACK, SKIP_FWD } from '../lib/player';

interface Props {
  showTitle: string;
  /** where "See all episodes" leads (the full archive, e.g. Spotify) */
  seeAllUrl: string;
  latest: Episode;
  episodes: Episode[];
}
const { showTitle, seeAllUrl, latest, episodes } = Astro.props as Props;
---

<section class="emb emb-ink" data-player>
  <audio data-audio preload="none" src={latest.audioUrl}></audio>

  <div class="emb-v">
    <!-- now playing -->
    <div class="emb-vtop">
      <div class="emb-vcover">
        <Image
          src={podcastImage(latest.imageFile)}
          alt={`${latest.title} cover`}
          widths={[280, 560]}
          sizes="280px"
          class="emb-vcover-img"
        />
      </div>
      <h2 class="emb-title">{latest.title}</h2>
      <p class="emb-show">{showTitle} · Latest episode</p>

      <button
        type="button"
        class="emb-scrub"
        data-scrub
        aria-label="Seek"
        role="slider"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <i data-progress></i>
      </button>
      <div class="emb-times">
        <span data-cur>0:00</span><span data-dur>{latest.duration}</span>
      </div>

      <div class="emb-vctls">
        <button type="button" class="emb-ic" data-back aria-label={`Back ${SKIP_BACK} seconds`}>
          <PlayerIcon name="back" />
        </button>

        <a class="emb-play big" data-play href={latest.pageUrl} aria-label="Play latest episode">
          <PlayerIcon name="play" class="i-play" />
          <PlayerIcon name="pause" class="i-pause" />
        </a>

        <button type="button" class="emb-ic" data-fwd aria-label={`Forward ${SKIP_FWD} seconds`}>
          <PlayerIcon name="fwd" />
        </button>

        <span class="emb-vspacer"></span>

        <button type="button" class="emb-speed" data-speed aria-label="Playback speed">1×</button>
        <button type="button" class="emb-ic" data-mute aria-label="Mute">
          <PlayerIcon name="mute" />
        </button>
      </div>
    </div>

    <!-- episode list -->
    <div class="emb-list inset">
      <p class="emb-listhead">Episodes</p>
      {
        episodes.map((ep, i) => (
          <a
            class:list={['emb-row', { active: i === 0 }]}
            href={ep.pageUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="emb-rowart">
              <Image src={podcastImage(ep.imageFile)} alt="" widths={[42, 84, 126]} sizes="42px" class="emb-rowart-img" />
            </span>
            <span class="emb-rowplay" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" />
                <path d="M9.6 7.8 L16.2 12 L9.6 16.2 Z" fill="currentColor" stroke="none" />
              </svg>
            </span>
            <span class="emb-rowmain">
              <span class="emb-rowtitle">{ep.title}</span>
              <time class="emb-rowdate" datetime={ep.date || undefined}>{ep.dateLabel}</time>
            </span>
            <span class="emb-rowtime">{ep.minutes}</span>
          </a>
        ))
      }
      <a class="emb-seeall" href={seeAllUrl} target="_blank" rel="noopener noreferrer">See all episodes</a>
    </div>
  </div>
</section>

<style>
  .emb {
    /* Dark "Ink" scheme — every value comes from the player tokens in
       tokens.css (--slate*, --pl-*), so the palette has one source of truth
       and the styleguide swatches match the real controls. */
    background: var(--slate);
    border-radius: var(--radius-player);
    overflow: hidden;
    color: var(--pl-ink);
    box-shadow: 0 30px 70px -36px rgba(20, 16, 13, 0.7);
    margin: 14px var(--gutter) 6px;
  }

  .emb-title {
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.005em;
    color: #fff;
  }

  /* ---- now-playing (vertical, centered) ---- */
  .emb-v {
    display: flex;
    flex-direction: column;
  }
  .emb-vtop {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 22px 20px;
  }
  .emb-vcover {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.6);
  }
  .emb-vcover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .emb-v .emb-title {
    margin-top: 22px;
    font-size: var(--text-xl);
  }
  .emb-show {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--pl-muted);
    margin-top: var(--space-2);
  }

  .emb-scrub {
    width: 100%;
    height: 5px;
    border-radius: 5px;
    background: rgba(243, 236, 224, 0.22);
    position: relative;
    border: none;
    padding: 0;
    margin-top: 22px;
    cursor: pointer;
    touch-action: none;
  }
  .emb-scrub i {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    border-radius: 5px;
    background: var(--pl-accent);
  }
  .emb-scrub i::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
  }
  .emb-scrub:focus-visible {
    outline: 2px solid var(--pl-accent);
    outline-offset: 4px;
  }
  .emb-times {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--pl-muted);
    font-variant-numeric: tabular-nums;
    margin-top: 9px;
  }

  .emb-vctls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    width: 100%;
    justify-content: center;
  }
  .emb-vspacer {
    flex: 1;
    max-width: 36px;
  }
  /* the scrubber + times need JS; the Play control is always present (it's
     a link to the episode page until JS upgrades it to play/pause) */
  .emb-scrub,
  .emb-times {
    display: none;
  }
  [data-enhanced] .emb-scrub {
    display: block;
  }
  [data-enhanced] .emb-times {
    display: flex;
  }
  /* the other transport controls (besides Play) also need JS */
  .emb-vctls .emb-ic,
  .emb-vctls .emb-speed,
  .emb-vspacer {
    display: none;
  }
  [data-enhanced] .emb-vctls .emb-ic,
  [data-enhanced] .emb-vctls .emb-speed {
    display: inline-flex;
  }
  [data-enhanced] .emb-vspacer {
    display: block;
  }

  .emb-ic {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--pl-ink);
    transition:
      background 0.16s var(--ease),
      color 0.16s var(--ease);
    padding: 0;
    flex: none;
  }
  /* the transport glyphs come from <PlayerIcon> (a child component), so
     their elements need :global() to be reached from this scoped sheet */
  .emb-ic :global(svg) {
    width: 24px;
    height: 24px;
  }
  .emb-ic:hover {
    background: rgba(243, 236, 224, 0.12);
  }
  [data-muted='true'] .emb-ic[data-mute] :global(.vol-wave) {
    display: none;
  }
  [data-muted='true'] .emb-ic[data-mute] {
    color: var(--pl-muted);
  }
  .emb-speed {
    border: 1px solid var(--pl-line);
    background: none;
    color: var(--pl-ink);
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 42px;
    flex: none;
    transition: background 0.16s var(--ease);
  }
  .emb-speed:hover {
    background: rgba(243, 236, 224, 0.12);
  }
  .emb-play {
    border: none;
    cursor: pointer;
    background: var(--pl-accent);
    color: #fff;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 66px;
    height: 66px;
    /* soft glow — makes the one tappable thing on the card unmissable */
    box-shadow:
      0 0 34px -4px rgba(229, 64, 13, 0.7),
      0 10px 24px -8px rgba(0, 0, 0, 0.5);
    transition:
      transform 0.16s var(--ease),
      box-shadow 0.16s var(--ease);
  }
  .emb-play:hover {
    transform: scale(1.05);
  }
  .emb-play :global(svg) {
    width: 30px;
    height: 30px;
  }
  .emb-play :global(.i-play) {
    margin-left: 2px;
  }
  .emb-play :global(.i-pause) {
    display: none;
  }
  [data-playing='true'] .emb-play :global(.i-play) {
    display: none;
  }
  [data-playing='true'] .emb-play :global(.i-pause) {
    display: inline;
    margin-left: 0;
  }

  /* ---- episode list ---- */
  .emb-list {
    padding: 6px 0 10px;
  }
  .emb-list.inset {
    background: var(--slate-2);
    border-top: 1px solid var(--pl-line);
    padding: var(--space-2) 0 var(--space-3);
  }
  .emb-listhead {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--pl-muted);
    padding: var(--space-4) var(--space-5) var(--space-2);
  }
  .emb-row {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    transition: background 0.16s var(--ease);
    padding: 12px 18px;
  }
  .emb-row:hover,
  .emb-row.active {
    background: var(--slate-3);
  }
  .emb-row.active .emb-rowtitle {
    color: #fff;
  }
  .emb-row.active .emb-rowplay {
    color: var(--pl-accent);
  }
  .emb-rowart {
    width: 42px;
    height: 42px;
    border-radius: 7px;
    overflow: hidden;
    flex: none;
    background: #fff;
    box-shadow: 0 6px 14px -8px rgba(0, 0, 0, 0.5);
  }
  .emb-rowart-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .emb-rowplay {
    color: var(--pl-muted);
    flex: none;
    display: inline-flex;
    transition: color 0.16s var(--ease);
  }
  .emb-rowplay svg {
    width: 24px;
    height: 24px;
  }
  .emb-row:hover .emb-rowplay {
    color: var(--pl-ink);
  }
  .emb-rowmain {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .emb-rowtitle {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--pl-ink);
    line-height: 1.25;
    /* wrap to at most two lines, then ellipsis — long titles read fully
       rather than truncating mid-word in the narrower list column. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .emb-rowdate {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--pl-muted);
  }
  .emb-rowtime {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--pl-muted);
    font-variant-numeric: tabular-nums;
    flex: none;
  }
  .emb-seeall {
    display: block;
    text-align: center;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--pl-ink);
    border: 1px solid var(--pl-line);
    border-radius: 999px;
    padding: 11px 18px;
    margin: 12px 18px 4px;
    transition: background 0.16s var(--ease);
  }
  .emb-seeall:hover {
    background: rgba(243, 236, 224, 0.12);
  }

  /* ---- tablet: centered single column ---- */
  @container page (min-width: 600px) {
    .emb {
      max-width: 520px;
      margin-inline: auto;
    }
    .emb-vtop {
      padding: 30px 30px 24px;
    }
  }

  /* ---- desktop/laptop: two columns (now-playing | list) ---- */
  @container page (min-width: 1024px) {
    .emb {
      /* share the content column's width so the player sits on the same centered
         axis as the page head + platform pills (the D2 "centered" layout) */
      max-width: var(--content-max);
    }
    .emb-v {
      display: grid;
      /* Now-playing card left, episode list right. minmax(0, …) lets the list
         column shrink so long episode titles wrap/clamp instead of forcing
         the grid to overflow. */
      grid-template-columns: 400px minmax(0, 1fr);
      align-items: stretch;
    }
    .emb-vtop {
      padding: 40px 36px;
      justify-content: center;
    }
    .emb-list.inset {
      border-top: none;
      border-left: 1px solid var(--pl-line);
      padding: 8px 0 14px;
      align-self: stretch;
    }
    .emb-listhead {
      padding: 26px 28px 12px;
    }
    .emb-row {
      padding: 13px 28px;
    }
    .emb-seeall {
      margin: 14px 28px 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .emb-play,
    .emb-ic,
    .emb-row,
    .emb-seeall {
      transition: none;
    }
  }
</style>

<script>
  import { initPlayers } from '../lib/player';
  initPlayers();
</script>
