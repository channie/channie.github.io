---
/* ============================================================
   Figure — an optimized image with an optional caption, for use
   inside MDX posts:

     import cover from './cover.jpg';
     <Figure src={cover} alt="…" caption="…" />
   ============================================================ */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}
const { src, alt = '', caption }: Props = Astro.props;
---

<figure class="post-figure">
  <Image src={src} alt={alt} widths={[480, 768, 1080]} sizes="(min-width: 768px) 720px, 92vw" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .post-figure {
    margin: 1.9em 0;
  }
  .post-figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-media);
    background: var(--card);
  }
  figcaption {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--muted);
    margin-top: 10px;
    text-align: center;
  }
</style>
