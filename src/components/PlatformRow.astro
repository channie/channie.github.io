---
/* ============================================================
   PlatformRow — "Listen & subscribe" pills under the podcast player.
   Each pill links out to a platform; the glyph is chosen by `slug`
   (artwork shared with the homepage band via data/platformGlyphs).
   ============================================================ */
import { platformGlyph } from '../data/platformGlyphs';

interface Platform {
  slug: string;
  name: string;
  url: string;
}
interface Props {
  platforms: Platform[];
}
const { platforms }: Props = Astro.props;
---

<div class="podx-platforms">
  <span class="ppx-label">Listen &amp; subscribe</span>
  <div class="ppx-pills">
    {
      platforms.map((p) => (
        <a class="ppx-pill" href={p.url} target="_blank" rel="noopener noreferrer">
          <span class="pglyph" aria-hidden="true" set:html={platformGlyph(p.slug)} />
          {p.name}
        </a>
      ))
    }
  </div>
</div>

<style>
  /* Centered column: label above, pills wrapping under it — the whole block
     shares the page's center axis with the head + player (the D2 layout). */
  .podx-platforms {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-direction: column;
    padding: 30px var(--gutter) 6px;
    max-width: var(--content-max);
    margin-inline: auto;
  }
  .ppx-label {
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--accent);
    flex: none;
  }
  .ppx-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 9px;
  }
  .ppx-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px 8px 11px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink);
    transition:
      background 0.16s var(--ease),
      border-color 0.16s var(--ease),
      color 0.16s var(--ease);
  }
  .pglyph {
    width: 17px;
    height: 17px;
    color: var(--accent);
    display: inline-flex;
    transition: color 0.16s var(--ease);
  }
  .pglyph :global(svg) {
    width: 100%;
    height: 100%;
  }
  .ppx-pill:hover {
    background: var(--band);
    border-color: var(--band);
    color: #fff;
  }
  .ppx-pill:hover .pglyph {
    color: #fff;
  }

  @container page (min-width: 600px) {
    .podx-platforms {
      padding-block: 34px 8px;
    }
  }
</style>
