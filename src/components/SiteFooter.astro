---
/* ============================================================
   SiteFooter — minimal footer.
   Top: stylized italic quote.
   Below: identity block — full name, role line, and a row of
   contact icons + copyright.
   ============================================================ */
import { site } from '../data/site';
import Icon from './Icon.astro';

// Split into sentences so the quote sits on one line where it fits, and only ever
// breaks at the sentence boundary — never mid-phrase (e.g. between "my" and "practice").
const quoteSentences = site.footer.quote.split(/(?<=\.)\s+/);
---

<footer class="site-footer">
  <p class="quote">“{quoteSentences.map((s, i) => (
    <Fragment><span class="sentence">{s}</span>{i < quoteSentences.length - 1 ? ' ' : ''}</Fragment>
  ))}”</p>

  <div class="identity">
    <p class="full-name">{site.fullName}</p>
    <p class="role">{site.footer.roleLine}</p>

    <div class="meta-row">
      {
        site.social.map((s) => (
          <a
            class="social"
            href={s.href}
            aria-label={s.label}
            {...s.href.startsWith('http')
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {}}
          >
            <Icon name={s.icon} size={19} />
          </a>
        ))
      }
      <span class="copyright">{site.footer.copyright}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--line);
    /* breathing room between the end of page content and the footer line */
    margin-top: 32px;
    text-align: center;
    padding: 40px var(--gutter);
    /* clear the phone's home indicator / bottom browser bar so the
       contact row + copyright aren't hidden under it */
    padding-bottom: calc(48px + env(safe-area-inset-bottom));
  }

  .quote {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--accent);
    font-size: 19px;
    line-height: 1.4;
  }
  /* Each sentence stays intact; line breaks (if any) fall between sentences. */
  .quote .sentence {
    white-space: nowrap;
  }

  .identity {
    margin-top: 28px;
  }
  .full-name {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 500;
    color: var(--ink);
  }
  .role {
    font-family: var(--font-sans);
    color: var(--accent);
    letter-spacing: 0.04em;
    font-size: 14px;
    margin-top: 10px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
    color: var(--accent);
  }
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    color: var(--accent);
    transition: background var(--dur-btn) var(--ease);
  }
  .social:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .copyright {
    font-family: var(--font-sans);
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.02em;
    margin-left: var(--space-1);
  }

  @container page (min-width: 600px) {
    .site-footer {
      margin-top: var(--space-10);
      padding: 50px var(--gutter);
      padding-bottom: calc(50px + env(safe-area-inset-bottom));
    }
    .quote {
      font-size: 22px;
    }
  }
  @container page (min-width: 1024px) {
    .site-footer {
      margin-top: var(--space-12);
      padding: 56px var(--gutter);
      padding-bottom: calc(56px + env(safe-area-inset-bottom));
    }
    .quote {
      font-size: 24px;
    }
  }
</style>
