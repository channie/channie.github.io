---
/* ============================================================
   BaseLayout — the shared document shell for every page.
   - <head> meta (title/description/OG basics)
   - Self-hosted fonts (Newsreader + Hanken Grotesk via @fontsource)
   - Design tokens + global styles
   - Skip link + shared SiteHeader / SiteFooter + <slot/> for content
   ============================================================ */

// Self-hosted fonts (no runtime CDN call). Newsreader leans on italics.
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
// Traditional-Chinese body face — LXGW WenKai TC (霞鶩文楷), the CJK fallback
// in the font tokens. Self-hosted woff2-only @font-face (see fonts-cjk.css);
// the @fontsource package is kept only as the source of the woff2 files.
import '../styles/fonts-cjk.css';

// Tokens first, then global base styles that consume them.
import '../styles/tokens.css';
import '../styles/global.css';

import { site } from '../data/site';
import { truncateDescription } from '../lib/meta';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** active nav label, for highlighting */
  active?: string;
  /**
   * 'inner' (default): render the shared SiteHeader.
   * 'none': the page renders its own header (e.g. the homepage hero).
   */
  header?: 'inner' | 'none';
  /** Open Graph type — 'article' for blog posts (adds article:published_time). */
  ogType?: 'website' | 'article';
  /** Share image, absolute or root-relative. Defaults to the site card. */
  ogImage?: string;
  /** Share image metadata. Defaults describe the 1200×630 PNG cards in public/og/. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogImageAlt?: string;
  /** ISO date string, used when ogType='article'. */
  publishedTime?: string;
  /** Adds a noindex robots meta (e.g. the styleguide). NOTE: this does NOT
      remove the page from the sitemap — also add its path to NOINDEX_PATHS
      in src/data/seo.ts (the sitemap filter in astro.config.mjs reads it). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  active,
  header = 'inner',
  ogType = 'website',
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = 'image/png',
  ogImageAlt = `${site.name} — ${site.domain}`,
  publishedTime,
  noindex = false,
}: Props = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — personal site`;
/* Pages pass human-facing copy (a post's full excerpt, the podcast's RSS
   description), which runs longer than search results and link previews
   show. Trimmed here so every page is covered and a new long excerpt can't
   regress it; the visible text on the page is untouched. */
const metaDescription = truncateDescription(description);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImageUrl = new URL(ogImage ?? '/og/default.png', site.url).href;
const { goatcounter } = site.analytics;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f4e9d6" />

    <!-- Favicons + touch icon (committed in public/) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Blog feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Experimenting — Channie"
      href={new URL('/experimenting/rss.xml', site.url).href}
    />

    <meta name="generator" content={Astro.generator} />

    {/* Privacy-friendly analytics (GoatCounter): no cookies, no PII. Loads
        only when a site code is configured in src/data/site.ts (dormant
        otherwise). count.js is self-hosted; the count beacon is the one
        first-party-ish call. */}
    {goatcounter && (
      <script
        is:inline
        defer
        src="/js/count.js"
        data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
      />
    )}

    <!-- Per-page <head> additions (extra OG, JSON-LD, etc.) -->
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="page">
      {header === 'inner' && <SiteHeader active={active} />}

      <main id="main">
        <slot />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
